# Copy to .env and fill in. .env is gitignored; never commit it.

# Only needed for live model calls. Without a key, run with LLM_MODE=replay to
# replay the recorded responses in experiments/llm_cache/ (no network, no cost).
ANTHROPIC_API_KEY=

# Optional
# LLM_MODE=auto            # auto | live | replay
# LLM_BUDGET_USD=100       # stop live calls once estimated spend reaches this
