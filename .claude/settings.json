{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/export_traces.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/export_traces.py\" --hook",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Skill",
      "Read(~/.claude/**)",
      "Read(~/.config/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/**)"
    ]
  }
}
